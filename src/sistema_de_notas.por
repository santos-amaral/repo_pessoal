// HISTÓRICO ESCOLAR - NOME - TURMA - ANO DE FORMAÇÃO - EXÉRCITO - ARMA - MEDIA - 

programa{
    funcao inicio (){
        cadeia nome
        cadeia turma
        inteiro ano
        cadeia eb
        cadeia arma
        real media
        
            enquanto (eb == "nao"){
            escreva("Olá, jovem combatente! Insira seu nome para darmos início: ")
            leia(nome)
            escreva("\nVocê deseja servir ao Exército Brasileiro? (sim/nao)")
            leia(eb)
            }
            escreva("\nQual será sua Qualificação Militar?(Engenhharia, Infantaria, Cavalaria, Comunicações ou Artilharia)")
            leia(arma)







        
        escreva("Até a próxima. Vejo você no combate!")
    }
}